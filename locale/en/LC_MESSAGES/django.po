msgid ""
"Ihr Antrag ist eingebracht und sammelt jetzt Unterstützung. Automatisch "
"zugeordnet: %s."
msgstr "Your motion has been submitted and is now gathering support. Automatically assigned: %s."

msgid "Ihr Antrag ist eingebracht und sammelt jetzt Unterstützung."
msgstr "Your motion has been submitted and is now gathering support."

msgid "Die Unterstützungsphase dieses Antrags ist beendet."
msgstr "The support phase of this motion has ended."

msgid "Danke — Ihre Unterstützung ist erfasst."
msgstr "Thank you — your support has been recorded."

msgid "Ihre Unterstützung wurde zurückgezogen."
msgstr "Your support has been withdrawn."

msgid "Die Beratung dieses Antrags ist beendet."
msgstr "The deliberation of this motion has ended."

msgid "Ihr Beitrag ist veröffentlicht."
msgstr "Your contribution has been published."

msgid "Ihre Stimme ist erfasst — bis zum Fristende können Sie sie ändern."
msgstr "Your vote has been recorded — you can change it until the deadline."

msgid "Diese Stimme konnte nicht erfasst werden (läuft die Abstimmung noch?)."
msgstr "This vote could not be recorded (is the vote still open?)."

msgid ""
"Als Favorit gemerkt — Sie finden das Thema jetzt in Ihrem Bereich auf der "
"Startseite."
msgstr "Saved as a favourite — you will now find the topic in your area on the home page."

msgid "Favorit entfernt."
msgstr "Favourite removed."

