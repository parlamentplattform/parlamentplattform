"  <a href=\"mailto:plattform@ddoe.at\">plattform@ddoe.at</a>."
msgstr "Direkte Demokratie Österreich (DDÖ), Unterfreundorf 17, 4076 Unterfreundorf, Austria. Party register number 502117. Contact for all questions about data protection: <a href=\"mailto:plattform@ddoe.at\">plattform@ddoe.at</a>."

