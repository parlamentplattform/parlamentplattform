msgstr "public · with history"

msgid "Staatsapparat"
msgstr "State apparatus"

msgid "Mandatare bringen ein"
msgstr "mandate holders introduce it"

msgid "Vollzug · Prognoseabgleich"
msgstr "execution · forecast comparison"

msgid "KI: Ähnlichkeitshinweis · Themen-Zuordnung"
msgstr "AI: similarity hint · topic classification"

msgid "ENTWURFSSCHLEIFE · § 5 ABS 12"
msgstr "DRAFTING LOOP · § 5 PARA. 12"

