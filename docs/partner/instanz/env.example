# ParlamentPlattform — Umgebungsvariablen einer Landesinstanz (nach .env kopieren, ausfüllen).
# Keine dieser Werte gehört in ein Repository.

# Kennung im gemeinsamen Schema (docs/SCHEMA.md): <ländercode>-<kurzname>, und der volle Name
DDOE_SYSTEM_ID=xx-partei
DDOE_SYSTEM_NAME=Name der Partei

# Django-Grundlagen
DDOE_SECRET_KEY=hier-einen-langen-zufaelligen-schluessel-eintragen
DDOE_DEBUG=0
DDOE_ALLOWED_HOSTS=parlament.partei.example
DDOE_CSRF_ORIGINS=https://parlament.partei.example
DDOE_BASIS_URL=https://parlament.partei.example
DDOE_STATIK=whitenoise

# Datenbank (bei docker-compose.yml ist der Host „db“)
POSTGRES_DB=plattform
POSTGRES_USER=plattform
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_PORT=5432

# E-Mail für Anmelde-Links (SMTP des eigenen Postfachs)
DDOE_MAIL_ABSENDER=ParlamentPlattform <plattform@partei.example>
DDOE_SMTP_HOST=
DDOE_SMTP_PORT=587
DDOE_SMTP_USER=
DDOE_SMTP_PASSWORT=

# Erste Verwaltung (Adresse des ersten Admin-Kontos) und Übergangsregel des Alpha-Betriebs
DDOE_FIX_ADMIN=admin@partei.example
DDOE_UEBERGANGSREGEL=1

# Zukunftswerkstatt (optional): Modell-Steckplatz und Monatsbudget
DDOE_KI_ANBIETER=mistral
DDOE_KI_SCHLUESSEL=
DDOE_KI_MODELL=mistral-small-latest
DDOE_KI_MONATSTOKENS=1000000
