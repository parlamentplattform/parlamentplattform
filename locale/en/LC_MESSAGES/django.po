#, python-format
msgid "„%(neu)s“ ist eine andere Verfahrensordnung als die geltende „%(alt)s“ — ein Wechsel gehört nicht in die Parameterverwaltung."
msgstr "“%(neu)s” is a different set of procedural rules from the current “%(alt)s” — a switch does not belong in parameter administration."

#, python-format
msgid "„%(schluessel)s“: %(alt)s → %(neu)s. Grund steht im öffentlichen Audit-Log."
msgstr "“%(schluessel)s”: %(alt)s → %(neu)s. The reason is in the public audit log."

